// Luna's own controls. Every interactive control shows hover, pressed,
// disabled and a keyboard focus ring.

import { Theme } from "theme.slint";

export enum ButtonKind { primary, secondary, quiet }

export component LunaButton {
    in property <string> text;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <bool> large: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: fs;
    min-height: root.large ? 44px : 34px;
    min-width: label.preferred-width + (root.large ? 56px : 28px);
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius;
        border-width: root.kind == ButtonKind.secondary ? 1px : 0px;
        border-color: ta.has-hover && root.enabled ? Theme.text-faint : Theme.line-strong;
        background: !root.enabled ? (root.kind == ButtonKind.quiet ? transparent : Theme.raised)
            : root.kind == ButtonKind.primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
            : root.kind == ButtonKind.secondary ? (ta.pressed ? Theme.raised : ta.has-hover ? Theme.raised-hover : Theme.raised)
            : (ta.pressed ? Theme.raised-hover : ta.has-hover ? Theme.raised : transparent);
        animate background { duration: 90ms; }
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.large ? Theme.size-lead : 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? Theme.text-faint
            : root.kind == ButtonKind.primary ? Theme.on-accent
            : root.kind == ButtonKind.quiet && !ta.has-hover ? Theme.text-muted
            : Theme.text;
    }

    fs := FocusScope {
        focus-on-click: false;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius + 3px;
        border-width: 2px;
        border-color: Theme.focus;
        visible: fs.has-focus;
    }
}

// A square button with a drawn icon, for compact row actions.
export enum IconKind { up, down, remove }

export component IconButton {
    in property <IconKind> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: fs;
    width: 32px;
    height: 32px;

    Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? transparent : ta.pressed ? Theme.raised-hover : ta.has-hover ? Theme.raised : transparent;
    }

    Path {
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: root.icon == IconKind.up ? "M 3 9 L 7 5 L 11 9"
            : root.icon == IconKind.down ? "M 3 5 L 7 9 L 11 5"
            : "M 3.5 3.5 L 10.5 10.5 M 10.5 3.5 L 3.5 10.5";
        stroke: !root.enabled ? Theme.line-strong : (ta.has-hover && root.icon == IconKind.remove) ? Theme.problem : ta.has-hover ? Theme.text : Theme.text-muted;
        stroke-width: 1.6px;
        fill: transparent;
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
        visible: fs.has-focus;
    }
}

export component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    callback edited(string);

    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    forward-focus: input;
    min-height: 38px;
    min-width: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    Rectangle {
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : ta.has-hover ? Theme.text-faint : Theme.line-strong;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.size-body;
        overflow: elide;
        visible: input.text == "";
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.size-body;
        selection-background-color: #e9a64059;
        selection-foreground-color: Theme.text;
        edited => {
            root.edited(self.text);
        }
    }
}

export component ProgressBar {
    in property <float> progress;
    in property <bool> indeterminate;

    accessible-role: progress-indicator;
    accessible-value: root.indeterminate ? "" : round(root.progress * 100) + "%";
    height: 6px;
    horizontal-stretch: 1;

    Rectangle {
        border-radius: 3px;
        background: Theme.raised;
        clip: true;

        if !root.indeterminate: Rectangle {
            x: 0;
            height: parent.height;
            width: max(parent.height, parent.width * clamp(root.progress, 0, 1));
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 240ms; easing: ease-out; }
        }

        if root.indeterminate: Rectangle {
            property <float> phase: mod(animation-tick() / 1600ms, 1);
            width: parent.width * 0.28;
            x: (parent.width + self.width) * self.phase - self.width;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
        }
    }
}

// A short file-type tag, e.g. PDF.
export component FileTag {
    in property <string> text;
    width: 46px;
    height: 22px;

    Rectangle {
        border-radius: 4px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line-strong;
    }

    Text {
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component FolderGlyph {
    in property <color> color: Theme.text-muted;
    width: 20px;
    height: 20px;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 2.5 5.5 L 2.5 15.5 Q 2.5 16.5 3.5 16.5 L 16.5 16.5 Q 17.5 16.5 17.5 15.5 L 17.5 7.5 Q 17.5 6.5 16.5 6.5 L 9.5 6.5 L 7.8 4.2 Q 7.5 3.8 7 3.8 L 3.5 3.8 Q 2.5 3.8 2.5 4.8 Z";
        stroke: root.color;
        stroke-width: 1.4px;
        fill: transparent;
    }
}

// Section heading for the Settings window.
export component SectionHeading {
    in property <string> title;
    in property <string> note;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.title;
            font-size: Theme.size-lead;
            font-weight: 600;
            color: Theme.text;
        }

        if root.note != "": Text {
            text: root.note;
            font-size: 13px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// A labelled text field (label above).
export component Field {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);

    VerticalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.text-muted;
        }

        TextField {
            label: root.label;
            text <=> root.text;
            placeholder: root.placeholder;
            edited(t) => {
                root.edited(t);
            }
        }
    }
}

// An inline error line.
export component ErrorLine {
    in property <string> text;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            padding-top: 6px;
            alignment: start;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.problem;
            }
        }

        Text {
            text: root.text;
            color: Theme.problem;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}
