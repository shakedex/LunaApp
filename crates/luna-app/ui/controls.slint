// Luna's own controls. Every interactive control shows hover, pressed,
// disabled and a keyboard focus ring.

import { Theme } from "theme.slint";

export enum ButtonKind { primary, secondary, quiet }

// A Phosphor icon (regular weight), tinted to the theme.
export component Icon inherits Image {
    in property <color> tint: Theme.text-muted;
    width: 18px;
    height: 18px;
    colorize: root.tint;
    image-fit: contain;
    accessible-role: none;
}

export component LunaButton {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <bool> large: false;
    callback clicked;
    property <bool> has-icon: root.icon.width > 0;
    property <color> ink: !root.enabled ? Theme.text-faint
        : root.kind == ButtonKind.primary ? Theme.on-accent
        : root.kind == ButtonKind.quiet && !ta.has-hover ? Theme.text-muted
        : Theme.text;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: fs;
    min-height: root.large ? 34px : 28px;
    min-width: label.preferred-width + (root.has-icon ? 22px : 0px) + (root.large ? 32px : 22px);
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius;
        border-width: root.kind == ButtonKind.secondary ? 1px : 0px;
        border-color: ta.has-hover && root.enabled ? Theme.text-faint : Theme.line-strong;
        background: !root.enabled ? (root.kind == ButtonKind.quiet ? transparent : Theme.raised)
            : root.kind == ButtonKind.primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
            : root.kind == ButtonKind.secondary ? (ta.pressed ? Theme.raised : ta.has-hover ? Theme.raised-hover : Theme.raised)
            : (ta.pressed ? Theme.raised-hover : ta.has-hover ? Theme.raised : transparent);
        animate background { duration: 90ms; }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 15px;
                height: 15px;
                tint: root.ink;
            }
        }
        label := Text {
            text: root.text;
            font-size: root.large ? 13px : 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.ink;
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius + 3px;
        border-width: 2px;
        border-color: Theme.focus;
        visible: fs.has-focus;
    }
}

// A square button with an icon, for compact row actions.
export component IconButton {
    in property <image> icon;
    in property <bool> danger;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: fs;
    width: 32px;
    height: 32px;

    Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? transparent : ta.pressed ? Theme.raised-hover : ta.has-hover ? Theme.raised : transparent;
    }

    Icon {
        source: root.icon;
        width: 18px;
        height: 18px;
        tint: !root.enabled ? Theme.line-strong : (ta.has-hover && root.danger) ? Theme.problem : ta.has-hover ? Theme.text : Theme.text-muted;
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
        visible: fs.has-focus;
    }
}

export component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    callback edited(string);

    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    forward-focus: input;
    min-height: 38px;
    min-width: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    Rectangle {
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : ta.has-hover ? Theme.text-faint : Theme.line-strong;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.size-body;
        overflow: elide;
        visible: input.text == "";
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.size-body;
        selection-background-color: #e9a64059;
        selection-foreground-color: Theme.text;
        edited => {
            root.edited(self.text);
        }
    }
}

// Two mutually exclusive options, e.g. Light / Dark.
export component Segmented {
    in property <string> first;
    in property <string> second;
    in property <bool> second-selected;
    in property <string> label;
    callback changed(bool);

    accessible-role: tab-list;
    accessible-label: root.label;
    height: 26px;

    Rectangle {
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.line-strong;
    }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in [root.first, root.second]: Rectangle {
            property <bool> selected: (i == 1) == root.second-selected;
            horizontal-stretch: 1;
            border-radius: Theme.radius - 2px;
            background: self.selected ? Theme.raised-hover : seg-ta.has-hover ? Theme.raised : transparent;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: self.selected;
            accessible-action-default => {
                root.changed(i == 1);
            }
            Text {
                text: option;
                font-size: 12px;
                font-weight: parent.selected ? 600 : 400;
                color: parent.selected ? Theme.text : Theme.text-muted;
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.changed(i == 1);
                }
            }
        }
    }
}

// Section heading for the Settings window.
export component SectionHeading {
    in property <string> title;
    in property <string> note;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.title;
            font-size: Theme.size-lead;
            font-weight: 600;
            color: Theme.text;
        }

        if root.note != "": Text {
            text: root.note;
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// A labelled text field (label above).
export component Field {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);

    VerticalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.text-muted;
        }

        TextField {
            label: root.label;
            text <=> root.text;
            placeholder: root.placeholder;
            edited(t) => {
                root.edited(t);
            }
        }
    }
}

// An inline error line.
export component ErrorLine {
    in property <string> text;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            padding-top: 6px;
            alignment: start;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.problem;
            }
        }

        Text {
            text: root.text;
            color: Theme.problem;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// A box to tick, with its label beside it; the label toggles it too.
export component Checkbox {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled(!root.checked);
    }
    min-height: 24px;

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                background: root.checked ? (ta.has-hover ? Theme.accent-hover : Theme.accent) : Theme.field;
                border-width: root.checked ? 0px : 1px;
                border-color: ta.has-hover ? Theme.text-faint : Theme.line-strong;
                if root.checked: Icon {
                    source: @image-url("icons/check.svg");
                    width: 12px;
                    height: 12px;
                    tint: Theme.on-accent;
                }
            }
        }

        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}
