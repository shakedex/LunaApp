// Settings: what the report header says, the logo, custom fields, the report
// theme and where reports go, on one page; credits behind a link. Takes the
// window's place below the title bar while open; edits are kept as a draft
// until Save. The state lives
// in `SettingsState` so the Rust side can fill and read it.

import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { LunaButton, ButtonKind, IconButton, TextField, ErrorLine, Icon, Segmented, Checkbox } from "controls.slint";

export struct CustomField {
    label: string,
    value: string,
}

// A third-party component credited in About.
export struct Component {
    name: string,
    licence: string,
    role: string,
}

export global SettingsState {
    in-out property <bool> show-credits;
    in-out property <string> production;
    in-out property <string> company;
    in-out property <string> author;
    in property <image> logo;
    in property <bool> has-logo;
    in property <string> logo-name;
    in property <string> logo-error;
    in property <[CustomField]> fields;
    in property <string> output-dir;
    in property <bool> can-save;
    in property <bool> report-dark;
    in property <bool> copy-to-source;
    in property <bool> show-problems;
    in property <string> save-error;
    in property <[Component]> credits;
    // Luna's version, and whether this build can update itself (packaged
    // builds only).
    in property <string> app-version;
    in property <bool> can-check-updates;
    callback check-for-updates();
    callback show-logs();

    callback text-edited();
    callback pick-logo();
    callback remove-logo();
    callback add-field();
    callback remove-field(int);
    callback move-up(int);
    callback move-down(int);
    callback label-edited(int, string);
    callback value-edited(int, string);
    callback pick-output();
    callback save();
    callback cancel();
    callback set-report-dark(bool);
    callback set-copy-to-source(bool);
    callback set-show-problems(bool);
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// Label on the left, its control on the right.
component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 14px;
    min-height: 38px;

    Text {
        width: 76px;
        text: root.label;
        color: Theme.text-muted;
        vertical-alignment: center;
    }

    @children
}

component TextRow inherits Row {
    in-out property <string> text;
    in property <string> placeholder;

    TextField {
        label: root.label;
        placeholder: root.placeholder;
        text <=> root.text;
        edited => {
            SettingsState.text-edited();
        }
    }
}

component Card inherits Rectangle {
    border-radius: Theme.radius-large;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
}

component CardTitle inherits Text {
    font-size: Theme.size-lead;
    font-weight: 600;
    color: Theme.text;
}

component ColumnLabel inherits Text {
    font-size: Theme.size-small;
    color: Theme.text-faint;
}

component CreditsList inherits Card {
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 24px;
            padding-top: 12px;
            for c[i] in SettingsState.credits: VerticalLayout {
                if i > 0: Rule { }
                HorizontalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 16px;
                    Text {
                        text: c.name;
                        font-weight: 600;
                        color: Theme.text;
                        width: 150px;
                        overflow: elide;
                    }

                    Text {
                        text: c.role;
                        color: Theme.text-muted;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: c.licence;
                        color: Theme.text-faint;
                        horizontal-alignment: right;
                    }
                }
            }
            HorizontalLayout {
                padding-top: 16px;
                alignment: space-between;
                AboutSlint {
                    width: 160px;
                    height: 96px;
                }

                Text {
                    text: "Luna is MIT licensed";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    background: Theme.canvas;

    VerticalLayout {
        // Back to the moon, or from Credits back to Settings.
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 22px;
            padding-bottom: 10px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/arrow-left.svg");
                    label: "Back";
                    clicked => {
                        if (SettingsState.show-credits) {
                            SettingsState.show-credits = false;
                        } else {
                            SettingsState.cancel();
                        }
                    }
                }
            }

            Text {
                text: SettingsState.show-credits ? "Credits" : "Settings";
                font-size: Theme.size-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        if SettingsState.show-credits: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 22px;
            CreditsList { }
        }

        if !SettingsState.show-credits: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 16px;

            // What the report says and where it goes.
            Card {
                horizontal-stretch: 1;
                preferred-width: 360px;
                VerticalLayout {
                    alignment: start;
                    padding: 22px;
                    spacing: 10px;
                    CardTitle {
                        text: "Report";
                    }

                    Rectangle {
                        height: 2px;
                    }

                    TextRow {
                        label: "Production";
                        placeholder: "The Long Night";
                        text <=> SettingsState.production;
                    }

                    TextRow {
                        label: "Company";
                        placeholder: "Production company";
                        text <=> SettingsState.company;
                    }

                    TextRow {
                        label: "Report by";
                        placeholder: "Your name";
                        text <=> SettingsState.author;
                    }

                    Row {
                        label: "Theme";
                        HorizontalLayout {
                            alignment: start;
                            Segmented {
                                y: (parent.height - self.height) / 2;
                                width: 160px;
                                label: "Report theme";
                                first: "Light";
                                second: "Dark";
                                second-selected: SettingsState.report-dark;
                                changed(d) => {
                                    SettingsState.set-report-dark(d);
                                }
                            }
                        }
                    }

                    Row {
                        label: "Destination";
                        Rectangle {
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.line-strong;
                            HorizontalLayout {
                                padding: 5px;
                                padding-left: 12px;
                                spacing: 8px;
                                Text {
                                    text: SettingsState.output-dir;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                LunaButton {
                                    text: "Change";
                                    icon: @image-url("icons/folder-open.svg");
                                    clicked => {
                                        SettingsState.pick-output();
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 90px;
                        Checkbox {
                            text: "Also save on the source drive";
                            checked: SettingsState.copy-to-source;
                            toggled(on) => {
                                SettingsState.set-copy-to-source(on);
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 90px;
                        Checkbox {
                            text: "Show problems in reports";
                            checked: SettingsState.show-problems;
                            toggled(on) => {
                                SettingsState.set-show-problems(on);
                            }
                        }
                    }
                }
            }

            // The logo and the custom fields printed in the header.
            Card {
                horizontal-stretch: 1;
                preferred-width: 360px;
                VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    CardTitle {
                        text: "Logo";
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Rectangle {
                            width: 132px;
                            height: 60px;
                            border-radius: Theme.radius;
                            // Logos are mostly drawn for white paper; preview them on light.
                            background: SettingsState.has-logo ? #f3f4f6 : Theme.field;
                            border-width: 1px;
                            border-color: Theme.line-strong;
                            if SettingsState.has-logo: Image {
                                x: 8px;
                                y: 8px;
                                width: parent.width - 16px;
                                height: parent.height - 16px;
                                source: SettingsState.logo;
                                image-fit: contain;
                            }
                            if !SettingsState.has-logo: Icon {
                                source: @image-url("icons/image.svg");
                                width: 22px;
                                height: 22px;
                                tint: Theme.text-faint;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: SettingsState.has-logo ? SettingsState.logo-name : "PNG, JPEG or SVG";
                                color: Theme.text-muted;
                                overflow: elide;
                                max-width: 200px;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                LunaButton {
                                    text: SettingsState.has-logo ? "Replace" : "Choose logo";
                                    icon: @image-url("icons/folder-open.svg");
                                    clicked => {
                                        SettingsState.pick-logo();
                                    }
                                }

                                if SettingsState.has-logo: IconButton {
                                    icon: @image-url("icons/trash.svg");
                                    label: "Remove logo";
                                    danger: true;
                                    clicked => {
                                        SettingsState.remove-logo();
                                    }
                                }
                            }
                        }
                    }

                    if SettingsState.logo-error != "": ErrorLine {
                        text: SettingsState.logo-error;
                    }

                    Rectangle {
                        height: 4px;
                    }

                    Rule { }

                    Rectangle {
                        height: 4px;
                    }

                    CardTitle {
                        text: "Fields";
                    }

                    fields-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: fields-scroll.visible-width;
                            alignment: start;
                            spacing: 8px;
                            if SettingsState.fields.length > 0: HorizontalLayout {
                                spacing: 6px;
                                ColumnLabel {
                                    horizontal-stretch: 2;
                                    preferred-width: 90px;
                                    min-width: 80px;
                                    text: "Label";
                                }

                                ColumnLabel {
                                    horizontal-stretch: 3;
                                    preferred-width: 90px;
                                    min-width: 80px;
                                    text: "Value";
                                }

                                Rectangle {
                                    width: 3 * 32px + 2 * 6px;
                                }
                            }

                            for field[i] in SettingsState.fields: HorizontalLayout {
                                spacing: 6px;
                                TextField {
                                    horizontal-stretch: 2;
                                    preferred-width: 90px;
                                    min-width: 80px;
                                    label: "Label of field " + (i + 1);
                                    text: field.label;
                                    placeholder: "Shoot day";
                                    edited(t) => {
                                        SettingsState.label-edited(i, t);
                                    }
                                }

                                TextField {
                                    horizontal-stretch: 3;
                                    preferred-width: 90px;
                                    min-width: 80px;
                                    label: "Value of field " + (i + 1);
                                    text: field.value;
                                    placeholder: "12";
                                    edited(t) => {
                                        SettingsState.value-edited(i, t);
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    IconButton {
                                        icon: @image-url("icons/caret-up.svg");
                                        label: "Move field " + (i + 1) + " up";
                                        enabled: i > 0;
                                        clicked => {
                                            SettingsState.move-up(i);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    IconButton {
                                        icon: @image-url("icons/caret-down.svg");
                                        label: "Move field " + (i + 1) + " down";
                                        enabled: i < SettingsState.fields.length - 1;
                                        clicked => {
                                            SettingsState.move-down(i);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    IconButton {
                                        icon: @image-url("icons/trash.svg");
                                        danger: true;
                                        label: "Remove field " + (i + 1);
                                        clicked => {
                                            SettingsState.remove-field(i);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                LunaButton {
                                    text: "Add field";
                                    icon: @image-url("icons/plus.svg");
                                    clicked => {
                                        SettingsState.add-field();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !SettingsState.show-credits: HorizontalLayout {
            padding: 14px;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 10px;
            LunaButton {
                text: "Credits";
                kind: ButtonKind.quiet;
                clicked => {
                    SettingsState.show-credits = true;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Luna " + SettingsState.app-version;
                    color: Theme.text-faint;
                }
            }

            if SettingsState.can-check-updates: LunaButton {
                text: "Check for updates";
                kind: ButtonKind.quiet;
                clicked => {
                    SettingsState.check-for-updates();
                }
            }

            LunaButton {
                text: "Show logs";
                kind: ButtonKind.quiet;
                clicked => {
                    SettingsState.show-logs();
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                if SettingsState.save-error != "": ErrorLine {
                    text: SettingsState.save-error;
                }
                if SettingsState.save-error == "": Text {
                    text: SettingsState.can-save ? "Unsaved changes" : "";
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
            }

            LunaButton {
                text: "Discard";
                enabled: SettingsState.can-save;
                clicked => {
                    SettingsState.cancel();
                }
            }

            LunaButton {
                text: "Save";
                kind: ButtonKind.primary;
                enabled: SettingsState.can-save;
                clicked => {
                    SettingsState.save();
                }
            }
        }
    }
}
