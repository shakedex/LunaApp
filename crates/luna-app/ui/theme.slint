// Luna at night: midnight surfaces, moonlight text, and the blue of the
// crescent in Luna's logo for the next step. Coral only for problems.

export global Theme {
    out property <string> font: "IBM Plex Sans";

    // Surfaces, darkest to lightest. `chrome` is the toolbar and status bar,
    // `canvas` the clip area, `surface` the side panels, `raised` panel headers
    // and controls.
    out property <color> chrome: #07090d;
    out property <color> canvas: #0c0f14;
    out property <color> field: #090b0f;
    out property <color> surface: #11151b;
    out property <color> raised: #181d25;
    out property <color> raised-hover: #212833;
    out property <color> line: #1d232d;
    out property <color> line-strong: #2b3341;

    // Moonlight.
    out property <color> text: #e4e8ef;
    out property <color> text-muted: #99a2b2;
    out property <color> text-faint: #5d6676;

    // The logo's crescent.
    out property <color> accent: #79caea;
    out property <color> accent-hover: #95d7f1;
    out property <color> accent-pressed: #5fb7db;
    out property <color> accent-soft: #79caea1c;
    out property <color> on-accent: #04141c;
    out property <color> focus: #a9e2f6;

    out property <color> problem: #f07a6a;
    out property <color> problem-soft: #f07a6a1c;

    out property <length> radius: 4px;
    out property <length> radius-large: 6px;

    // Type scale: dense, like the tools DITs already use.
    out property <length> size-tiny: 10px;
    out property <length> size-small: 11px;
    out property <length> size-body: 12px;
    out property <length> size-lead: 14px;
    out property <length> size-title: 20px;
    out property <length> size-figure: 44px;
}
