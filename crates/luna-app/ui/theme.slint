// Cinema Dark: graphite surfaces, one tungsten accent, coral only for problems.

export global Theme {
    // Surfaces, darkest to lightest.
    out property <color> canvas: #121418;
    out property <color> field: #0d0f12;
    out property <color> surface: #181b20;
    out property <color> raised: #20242a;
    out property <color> raised-hover: #282d34;
    out property <color> line: #262a31;
    out property <color> line-strong: #3a4049;

    // Text.
    out property <color> text: #eceff3;
    out property <color> text-muted: #a3abb6;
    out property <color> text-faint: #6f7783;

    // The one accent: tungsten, like a 3200 K practical.
    out property <color> accent: #e9a640;
    out property <color> accent-hover: #f2b75e;
    out property <color> accent-pressed: #d4922c;
    out property <color> accent-soft: #e9a64014;
    out property <color> on-accent: #1d1406;
    out property <color> focus: #f5c97f;

    // Problems.
    out property <color> problem: #f2806f;
    out property <color> problem-soft: #f2806f14;

    out property <length> radius: 6px;
    out property <length> radius-large: 10px;

    // Type scale.
    out property <length> size-small: 12px;
    out property <length> size-body: 14px;
    out property <length> size-lead: 16px;
    out property <length> size-title: 26px;
    out property <length> size-figure: 60px;
}
