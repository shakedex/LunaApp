// The main window is one moon. It is new while Luna waits for a folder, waxes
// as clips are read, and is full when the report is written. Everything else
// lives in Settings.

import { Theme } from "theme.slint";
import { LunaButton, ButtonKind, ErrorLine, IconButton } from "controls.slint";

export enum Phase { idle, picked, running, done, failed, cancelled }

// A quiet text link: the secondary actions under the moon.
component TextLink {
    in property <string> text;
    in property <color> color: Theme.text-muted;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.text;
        font-size: Theme.size-body;
        color: ta.has-hover ? Theme.text : root.color;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    title: "Luna";
    icon: @image-url("assets/luna-icon.png");
    min-width: 720px;
    min-height: 560px;
    preferred-width: 880px;
    preferred-height: 640px;
    background: Theme.canvas;
    default-font-size: Theme.size-body;
    default-font-family: Theme.font;

    in property <Phase> phase: Phase.idle;
    in property <bool> drag-hover;
    in property <string> output-dir;
    in property <string> source;
    in property <string> source-name;
    in property <string> source-error;
    in property <string> files-found;
    in property <string> clips-done;
    in property <string> clips-total;
    in property <string> problems;
    in property <bool> has-problems;
    in property <float> progress;
    in property <bool> indeterminate;
    in property <bool> cancelling;
    in property <string> summary;
    in property <string> pdf-name;
    in property <string> html-name;
    in property <string> csv-name;
    in property <string> folder;
    in property <string> failure;
    in property <string> open-error;
    in property <string> header-production;
    in property <string> header-company;

    callback pick-folder();
    callback start();
    callback cancel();
    callback open-pdf();
    callback open-html();
    callback open-csv();
    callback show-folder();
    callback new-report();
    callback back();
    callback open-settings();
    callback open-credits();

    property <bool> waiting: root.phase == Phase.idle || root.phase == Phase.picked;
    // The engraved Moon, drawn live by `moon.rs`: the image is square, the
    // Moon takes 72% of it and the orbit dial 84%.
    in property <image> moon-image;
    out property <length> moon-box: 300px;

    // The whole window takes a click to choose a folder while Luna waits for one.
    if root.waiting: TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pick-folder();
        }
    }

    VerticalLayout {
        padding: 22px;
        padding-top: 18px;

        // Top line: Luna's logo, and Settings.
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("assets/luna-icon.png");
                    width: 22px;
                    height: 22px;
                }
            }

            Text {
                text: "Luna";
                font-size: Theme.size-lead;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            IconButton {
                icon: @image-url("icons/gear-six.svg");
                label: "Settings";
                clicked => {
                    root.open-settings();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        // The moon.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.moon-box;
                height: root.moon-box;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.moon-image;
                    image-fit: contain;
                    accessible-role: none;
                }

                // A blue ring on the dial while a folder is held over the window.
                Rectangle {
                    width: root.moon-box * 0.86;
                    height: self.width;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: root.drag-hover ? Theme.accent : transparent;
                    animate border-color { duration: 150ms; }
                }
            }
        }

        Rectangle {
            height: 12px;
        }

        // What is happening, in one line, and its detail.
        VerticalLayout {
            spacing: 8px;
            Text {
                text: root.phase == Phase.idle ? (root.drag-hover ? "Release to use this folder" : "Drop a camera folder")
                    : root.phase == Phase.picked ? root.source-name
                    : root.phase == Phase.running ? (root.cancelling ? "Stopping"
                        : root.indeterminate ? "Looking for clips"
                        : root.clips-done + " of " + root.clips-total + " clips")
                    : root.phase == Phase.done ? "Report ready"
                    : root.phase == Phase.failed ? "Report not written"
                    : "Cancelled";
                font-size: Theme.size-title;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.phase == Phase.idle ? "or click anywhere to choose one"
                    : root.phase == Phase.picked ? root.source
                    : root.phase == Phase.running ? (root.has-problems ? root.problems + " need attention" : root.source)
                    : root.phase == Phase.done ? root.summary
                    : root.phase == Phase.failed ? root.failure
                    : "Nothing was written.";
                font-size: Theme.size-body;
                color: (root.phase == Phase.running && root.has-problems)
                    || (root.phase == Phase.done && root.has-problems)
                    || root.phase == Phase.failed ? Theme.problem : Theme.text-faint;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if root.source-error != "" && root.phase == Phase.idle: HorizontalLayout {
                alignment: center;
                ErrorLine {
                    max-width: 420px;
                    text: root.source-error;
                }
            }
        }

        Rectangle {
            height: 26px;
        }

        // The one next step, and its quiet alternatives.
        HorizontalLayout {
            alignment: center;
            spacing: 18px;
            height: 34px;

            if root.phase == Phase.picked: LunaButton {
                text: "Create report";
                kind: ButtonKind.primary;
                large: true;
                clicked => {
                    root.start();
                }
            }
            if root.phase == Phase.picked: TextLink {
                text: "Change folder";
                clicked => {
                    root.pick-folder();
                }
            }

            if root.phase == Phase.running: LunaButton {
                text: root.cancelling ? "Stopping" : "Cancel";
                enabled: !root.cancelling;
                large: true;
                clicked => {
                    root.cancel();
                }
            }

            if root.phase == Phase.done: LunaButton {
                text: "Open PDF";
                kind: ButtonKind.primary;
                large: true;
                clicked => {
                    root.open-pdf();
                }
            }
            if root.phase == Phase.done: TextLink {
                text: "HTML";
                clicked => {
                    root.open-html();
                }
            }
            if root.phase == Phase.done: TextLink {
                text: "CSV";
                clicked => {
                    root.open-csv();
                }
            }
            if root.phase == Phase.done: TextLink {
                text: "Show in folder";
                clicked => {
                    root.show-folder();
                }
            }

            if root.phase == Phase.failed || root.phase == Phase.cancelled: LunaButton {
                text: "Back";
                large: true;
                clicked => {
                    root.back();
                }
            }
        }

        if root.open-error != "": HorizontalLayout {
            alignment: center;
            padding-top: 10px;
            ErrorLine {
                max-width: 420px;
                text: root.open-error;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        // Bottom line: which report this is, and where it goes.
        HorizontalLayout {
            spacing: 16px;
            TextLink {
                text: root.header-production == "" ? "No production set" : root.header-production;
                color: Theme.text-faint;
                clicked => {
                    root.open-settings();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.phase == Phase.done: TextLink {
                text: "New report";
                color: Theme.text-muted;
                clicked => {
                    root.new-report();
                }
            }

            if root.phase != Phase.done: Text {
                text: root.output-dir;
                font-size: Theme.size-body;
                color: Theme.text-faint;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                max-width: 360px;
            }
        }
    }
}
