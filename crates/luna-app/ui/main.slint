// The main window is one moon. It is new while Luna waits for a folder, waxes
// as clips are read, and is full when the report is written. Luna draws its
// own title bar; Settings takes the moon's place while it's open.

import { Theme } from "theme.slint";
import { LunaButton, ButtonKind, ErrorLine, Icon, IconButton, TextField } from "controls.slint";
import { SettingsView, SettingsState, CustomField } from "settings.slint";

export enum Phase { idle, picked, running, done, failed, cancelled }

// A quiet text link: the secondary actions under the moon.
component TextLink {
    in property <string> text;
    in property <color> color: Theme.text-muted;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.text;
        font-size: Theme.size-body;
        color: ta.has-hover ? Theme.text : root.color;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The title-bar mark while an update is waiting; opens the update window.
component UpdatePill {
    callback clicked;

    accessible-role: button;
    accessible-label: "Update";
    accessible-action-default => {
        root.clicked();
    }
    height: 24px;

    Rectangle {
        border-radius: self.height / 2;
        background: ta.pressed ? Theme.accent.with-alpha(0.24) : ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.55);
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 6px;
        alignment: center;
        Icon {
            source: @image-url("icons/arrow-circle-down.svg");
            width: 14px;
            height: 14px;
            tint: ta.has-hover ? Theme.accent-hover : Theme.accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: "Update";
            font-weight: 500;
            color: ta.has-hover ? Theme.accent-hover : Theme.accent;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A minimise / maximise / close button in the title bar.
component WindowButton {
    in property <image> icon;
    in property <string> label;
    in property <bool> close;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    width: 46px;

    Rectangle {
        background: !ta.has-hover ? transparent : root.close ? (ta.pressed ? #a3261a : #c42b1c) : (ta.pressed ? Theme.raised-hover : Theme.raised);
    }

    Icon {
        source: root.icon;
        width: 14px;
        height: 14px;
        tint: ta.has-hover && root.close ? #ffffff : Theme.text-muted;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A labelled control in the bottom bar: what it is, and what it's set to.
component FooterControl {
    in property <string> label;
    in property <string> value;
    in property <string> empty;
    in property <image> icon;
    in property <bool> align-right;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label + ": " + (root.value == "" ? root.empty : root.value);
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: Theme.radius;
        background: ta.pressed ? Theme.raised-hover : ta.has-hover ? Theme.raised : Theme.surface;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.accent : Theme.line-strong;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        alignment: root.align-right ? LayoutAlignment.end : LayoutAlignment.start;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 16px;
                height: 16px;
                tint: Theme.accent;
            }
        }

        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.label;
                font-size: Theme.size-tiny;
                color: Theme.text-faint;
                horizontal-alignment: root.align-right ? right : left;
            }

            Text {
                text: root.value == "" ? root.empty : root.value;
                font-size: Theme.size-body;
                font-weight: root.value == "" ? 600 : 400;
                color: root.value == "" ? Theme.accent : Theme.text;
                overflow: elide;
                horizontal-alignment: root.align-right ? right : left;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// What the report's header will say, bottom left. Collapsed it reads as one
// line; expanded it grows upwards into a row per value, edited in place.
component HeaderPanel inherits Rectangle {
    in property <string> production;
    // The production and every field value, joined for the collapsed bar.
    in property <string> summary;
    in property <[CustomField]> fields;
    in property <bool> enabled: true;
    in-out property <bool> open;
    callback production-edited(string);
    callback field-edited(int, string);
    callback manage();

    property <length> bar: 44px;
    property <length> row-height: 40px;
    property <int> rows: 1 + root.fields.length;
    property <bool> expanded: root.open && root.enabled;

    height: root.expanded ? root.bar + root.rows * root.row-height + 44px : root.bar;
    animate height { duration: 180ms; easing: ease-out; }
    clip: true;
    border-radius: Theme.radius-large;
    background: root.expanded ? Theme.surface : bar-ta.pressed ? Theme.raised-hover : bar-ta.has-hover ? Theme.raised : Theme.surface;
    border-width: 1px;
    border-color: !root.expanded && bar-ta.has-hover ? Theme.accent : Theme.line-strong;
    accessible-role: groupbox;
    accessible-label: "Report header";

    // The values, above the bar.
    VerticalLayout {
        y: 0;
        height: parent.height - root.bar;
        alignment: end;
        padding-left: 12px;
        padding-right: 8px;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: 140ms; }

        HorizontalLayout {
            height: 44px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                LunaButton {
                    text: "Edit fields";
                    icon: @image-url("icons/sliders-horizontal.svg");
                    kind: ButtonKind.quiet;
                    clicked => {
                        root.manage();
                    }
                }
            }
        }

        HorizontalLayout {
            height: root.row-height;
            spacing: 12px;
            padding-right: 4px;
            Text {
                width: 92px;
                text: "Production";
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                TextField {
                    min-height: 32px;
                    label: "Production";
                    placeholder: "The Long Night";
                    text: root.production;
                    edited(t) => {
                        root.production-edited(t);
                    }
                }
            }
        }

        for field[i] in root.fields: HorizontalLayout {
            height: root.row-height;
            spacing: 12px;
            padding-right: 4px;
            Text {
                width: 92px;
                text: field.label;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                TextField {
                    min-height: 32px;
                    label: field.label;
                    text: field.value;
                    edited(t) => {
                        root.field-edited(i, t);
                    }
                }
            }
        }
    }

    // The bar: what the header says now; click to open or close.
    Rectangle {
        y: parent.height - root.bar;
        height: root.bar;
        if root.expanded: Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: @image-url("icons/pencil-simple.svg");
                    width: 16px;
                    height: 16px;
                    tint: Theme.accent;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: "Report header";
                    font-size: Theme.size-tiny;
                    color: Theme.text-faint;
                }

                Text {
                    text: root.summary == "" ? "Add production" : root.summary;
                    font-size: Theme.size-body;
                    font-weight: root.summary == "" ? 600 : 400;
                    color: root.summary == "" ? Theme.accent : Theme.text;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: root.expanded ? @image-url("icons/caret-down.svg") : @image-url("icons/caret-up.svg");
                    width: 14px;
                    height: 14px;
                    tint: root.enabled ? Theme.text-muted : Theme.line-strong;
                }
            }
        }

        bar-ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.open = !root.open;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Luna";
    icon: @image-url("assets/luna-icon.png");
    // Windows: Luna draws the whole frame. macOS: the system frame, with Luna's
    // title bar under a transparent one, so the traffic lights sit on it.
    in property <bool> native-frame;
    no-frame: !root.native-frame;
    min-width: 720px;
    min-height: 560px;
    preferred-width: 880px;
    preferred-height: 640px;
    background: Theme.canvas;
    default-font-size: Theme.size-body;
    default-font-family: Theme.font;

    in property <Phase> phase: Phase.idle;
    in property <bool> drag-hover;
    in property <string> output-dir;
    in property <string> source;
    in property <string> source-name;
    in property <string> source-error;
    in property <string> files-found;
    in property <string> clips-done;
    in property <string> clips-total;
    in property <string> problems;
    in property <bool> has-problems;
    in property <float> progress;
    in property <bool> indeterminate;
    in property <bool> cancelling;
    in property <string> summary;
    in property <string> pdf-name;
    in property <string> html-name;
    in property <string> csv-name;
    in property <string> folder;
    in property <string> failure;
    in property <string> open-error;
    in property <string> header-production;
    in property <string> header-company;
    in property <[CustomField]> header-fields;
    in property <string> header-summary;
    in-out property <bool> header-open;
    in-out property <bool> settings-open;
    in property <bool> is-maximized;
    in property <bool> update-pending;

    callback pick-folder();
    callback start();
    callback cancel();
    callback open-pdf();
    callback open-html();
    callback open-csv();
    callback show-folder();
    callback new-report();
    callback back();
    callback open-settings();
    callback show-update();
    callback change-output();
    callback header-production-edited(string);
    callback header-field-edited(int, string);
    callback drag-window();
    callback toggle-maximized();
    callback minimize();
    callback close-window();
    // 0 north, 1 south, 2 east, 3 west, 4 north-east, 5 north-west,
    // 6 south-east, 7 south-west.
    callback resize-window(int);

    property <bool> waiting: (root.phase == Phase.idle || root.phase == Phase.picked) && !root.settings-open;
    // The engraved Moon's square: the Moon takes 72% of it, the dial 84%.
    out property <length> moon-box: 300px;
    // Where the Moon's centre is, for the sky drawn behind it.
    out property <length> moon-x: moon-frame.absolute-position.x + moon-frame.width / 2;
    out property <length> moon-y: moon-frame.absolute-position.y + moon-frame.height / 2;
    // The star chart and the Moon on it, drawn live by `backdrop.rs` and
    // `moon.rs` into one image behind everything.
    in property <image> backdrop-image;
    property <length> header-width: 320px;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.backdrop-image;
        image-fit: fill;
        accessible-role: none;
    }

    // The window takes a click anywhere to choose a folder while Luna waits.
    if root.waiting: TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.header-open) {
                root.header-open = false;
            } else {
                root.pick-folder();
            }
        }
    }

    VerticalLayout {
        // Title bar: drag to move, double-click to maximise. On macOS it matches
        // the system title bar's height, so the traffic lights line up with it.
        Rectangle {
            height: root.native-frame ? 32px : 44px;
            title-ta := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag-window();
                    }
                }
                double-clicked => {
                    root.toggle-maximized();
                }
            }

            HorizontalLayout {
                // macOS draws its window buttons in the top-left corner.
                padding-left: root.native-frame ? 80px : 16px;
                padding-right: root.native-frame ? 10px : 0px;
                spacing: 10px;

                // The logo, glowing softly in its own blue.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        Rectangle {
                            width: 54px;
                            height: 54px;
                            background: @radial-gradient(circle, #79caea8c 0%, #79caea40 30%, #79caea12 55%, #79caea00 72%);
                        }

                        Image {
                            source: @image-url("assets/luna-icon.png");
                            width: 22px;
                            height: 22px;
                        }
                    }
                }

                Text {
                    text: "Luna";
                    font-size: Theme.size-lead;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.update-pending: VerticalLayout {
                    alignment: center;
                    padding-right: 6px;
                    UpdatePill {
                        clicked => {
                            root.show-update();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    padding-right: 6px;
                    IconButton {
                        icon: @image-url("icons/gear-six.svg");
                        label: "Settings";
                        clicked => {
                            root.open-settings();
                        }
                    }
                }

                if !root.native-frame: WindowButton {
                    icon: @image-url("icons/minus.svg");
                    label: "Minimise";
                    clicked => {
                        root.minimize();
                    }
                }

                if !root.native-frame: WindowButton {
                    icon: root.is-maximized ? @image-url("icons/copy.svg") : @image-url("icons/square.svg");
                    label: root.is-maximized ? "Restore" : "Maximise";
                    clicked => {
                        root.toggle-maximized();
                    }
                }

                if !root.native-frame: WindowButton {
                    icon: @image-url("icons/x.svg");
                    label: "Close";
                    close: true;
                    clicked => {
                        root.close-window();
                    }
                }
            }
        }

        // Kept laid out under Settings, so the Moon's place is always known.
        Rectangle {
            vertical-stretch: 1;
            visible: !root.settings-open;
            VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 16px;

            Rectangle {
                vertical-stretch: 1;
            }

            // The moon.
            HorizontalLayout {
                alignment: center;
                moon-frame := Rectangle {
                    width: root.moon-box;
                    height: root.moon-box;

                    // A blue ring on the dial while a folder is held over the window.
                    Rectangle {
                        width: root.moon-box * 0.86;
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: root.drag-hover ? Theme.accent : transparent;
                        animate border-color { duration: 150ms; }
                    }
                }
            }

            Rectangle {
                height: 12px;
            }

            // What is happening, in one line, and its detail.
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: root.phase == Phase.idle ? (root.drag-hover ? "Release to use this folder" : "Drop a camera folder")
                        : root.phase == Phase.picked ? root.source-name
                        : root.phase == Phase.running ? (root.cancelling ? "Stopping"
                            : root.indeterminate ? "Looking for clips"
                            : root.clips-done + " of " + root.clips-total + " clips")
                        : root.phase == Phase.done ? "Report ready"
                        : root.phase == Phase.failed ? "Report not written"
                        : "Cancelled";
                    font-size: Theme.size-title;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.phase == Phase.idle ? "or click anywhere to choose one"
                        : root.phase == Phase.picked ? root.source
                        : root.phase == Phase.running ? (root.has-problems ? root.problems + " need attention" : root.source)
                        : root.phase == Phase.done ? root.summary
                        : root.phase == Phase.failed ? root.failure
                        : "Nothing was written.";
                    font-size: Theme.size-body;
                    color: (root.phase == Phase.running && root.has-problems)
                        || (root.phase == Phase.done && root.has-problems)
                        || root.phase == Phase.failed ? Theme.problem : Theme.text-faint;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.source-error != "" && root.phase == Phase.idle: HorizontalLayout {
                    alignment: center;
                    ErrorLine {
                        max-width: 420px;
                        text: root.source-error;
                    }
                }
            }

            Rectangle {
                height: 24px;
            }

            // The next step.
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                height: 34px;

                if root.phase == Phase.picked: LunaButton {
                    text: "Create report";
                    kind: ButtonKind.primary;
                    large: true;
                    clicked => {
                        root.start();
                    }
                }
                if root.phase == Phase.picked: LunaButton {
                    text: "Change folder";
                    icon: @image-url("icons/folder-open.svg");
                    kind: ButtonKind.quiet;
                    large: true;
                    clicked => {
                        root.pick-folder();
                    }
                }

                if root.phase == Phase.running: LunaButton {
                    text: root.cancelling ? "Stopping" : "Cancel";
                    enabled: !root.cancelling;
                    large: true;
                    clicked => {
                        root.cancel();
                    }
                }

                if root.phase == Phase.done: LunaButton {
                    text: "Open PDF";
                    kind: ButtonKind.primary;
                    large: true;
                    clicked => {
                        root.open-pdf();
                    }
                }
                if root.phase == Phase.done: LunaButton {
                    text: "New report";
                    icon: @image-url("icons/plus.svg");
                    large: true;
                    clicked => {
                        root.new-report();
                    }
                }

                if root.phase == Phase.failed || root.phase == Phase.cancelled: LunaButton {
                    text: "Back";
                    large: true;
                    clicked => {
                        root.back();
                    }
                }
            }

            // The rest of what was written.
            if root.phase == Phase.done: HorizontalLayout {
                alignment: center;
                spacing: 18px;
                padding-top: 12px;
                TextLink {
                    text: "Open HTML";
                    clicked => {
                        root.open-html();
                    }
                }

                TextLink {
                    text: "Open CSV";
                    clicked => {
                        root.open-csv();
                    }
                }

                TextLink {
                    text: "Show in folder";
                    clicked => {
                        root.show-folder();
                    }
                }
            }

            if root.open-error != "": HorizontalLayout {
                alignment: center;
                padding-top: 10px;
                ErrorLine {
                    max-width: 420px;
                    text: root.open-error;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            // Bottom bar: which production the report is for, and where it goes.
            HorizontalLayout {
                spacing: 16px;
                // Room for the header panel, drawn over the window below.
                Rectangle {
                    width: root.header-width;
                    height: 44px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                FooterControl {
                    label: "Destination";
                    value: root.output-dir;
                    empty: "Choose a folder";
                    icon: @image-url("icons/folder-open.svg");
                    align-right: true;
                    max-width: 420px;
                    clicked => {
                        root.change-output();
                    }
                }
            }
            }
        }
    }

    if root.settings-open: SettingsView {
        y: 44px;
        width: parent.width;
        height: parent.height - 44px;
    }

    if !root.settings-open: HeaderPanel {
        x: 22px;
        y: root.height - 16px - self.height;
        width: root.header-width;
        production: root.header-production;
        summary: root.header-summary;
        fields: root.header-fields;
        enabled: root.phase != Phase.running;
        open <=> root.header-open;
        production-edited(t) => {
            root.header-production-edited(t);
        }
        field-edited(i, t) => {
            root.header-field-edited(i, t);
        }
        manage => {
            root.header-open = false;
            root.open-settings();
        }
    }

    // Edges and corners for resizing, when the window has no system frame.
    if !root.is-maximized && !root.native-frame: Rectangle {
        property <length> edge: 5px;
        TouchArea {
            y: 0;
            height: parent.edge;
            mouse-cursor: MouseCursor.n-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(0); } }
        }
        TouchArea {
            y: parent.height - parent.edge;
            height: parent.edge;
            mouse-cursor: MouseCursor.s-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(1); } }
        }
        TouchArea {
            x: parent.width - parent.edge;
            width: parent.edge;
            mouse-cursor: MouseCursor.e-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(2); } }
        }
        TouchArea {
            x: 0;
            width: parent.edge;
            mouse-cursor: MouseCursor.w-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(3); } }
        }
        TouchArea {
            x: parent.width - parent.edge * 2;
            y: 0;
            width: parent.edge * 2;
            height: parent.edge * 2;
            mouse-cursor: MouseCursor.ne-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(4); } }
        }
        TouchArea {
            x: 0;
            y: 0;
            width: parent.edge * 2;
            height: parent.edge * 2;
            mouse-cursor: MouseCursor.nw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(5); } }
        }
        TouchArea {
            x: parent.width - parent.edge * 2;
            y: parent.height - parent.edge * 2;
            width: parent.edge * 2;
            height: parent.edge * 2;
            mouse-cursor: MouseCursor.se-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(6); } }
        }
        TouchArea {
            x: 0;
            y: parent.height - parent.edge * 2;
            width: parent.edge * 2;
            height: parent.edge * 2;
            mouse-cursor: MouseCursor.sw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(7); } }
        }
    }
}
