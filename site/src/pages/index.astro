---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Stage from "../components/Stage.astro";
import Report from "../components/Report.astro";
import Formats from "../components/Formats.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { copy } from "../copy";
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <div class="sky" aria-hidden="true"></div>
  <Nav />
  <main>
    <Stage />
    <Report />
    <Formats />
    <Download />
  </main>
  <Footer />
</Base>

<style>
  /* The app's star chart behind the top of the page, fading into the canvas. */
  .sky {
    position: absolute;
    inset: 0 0 auto;
    height: min(1400px, 150dvh);
    background: url("/img/sky.webp") center top / cover no-repeat;
    mask-image: linear-gradient(#000 55%, transparent);
    pointer-events: none;
    z-index: 0;
  }
  main,
  :global(.footer),
  :global(.nav) {
    position: relative;
  }
</style>
