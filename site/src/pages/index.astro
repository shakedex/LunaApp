---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Stage from "../components/Stage.astro";
import Report from "../components/Report.astro";
import Formats from "../components/Formats.astro";
import Features from "../components/Features.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { copy } from "../copy";
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <canvas class="sky" id="sky" aria-hidden="true"></canvas>
  <Nav />
  <main>
    <Stage />
    <Report />
    <Formats />
    <Features />
    <Download />
  </main>
  <Footer />
</Base>

<script>
  import { runSky } from "../scripts/sky";
  const sky = document.getElementById("sky") as HTMLCanvasElement | null;
  if (sky) runSky(sky);
</script>

<style>
  /* The app's star chart, turning behind the whole page. */
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  main,
  :global(.footer),
  :global(.nav) {
    position: relative;
  }
</style>
