---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { copy } from "../copy";
---

<Base title={`${copy.notFound.title}, Luna`} description={copy.notFound.title} noindex>
  <Nav />
  <main class="wrap">
    <h1 class="title">{copy.notFound.title}</h1>
    <a class="btn btn-quiet" href="/">{copy.notFound.back}</a>
  </main>
  <Footer />
</Base>

<style>
  main {
    min-height: calc(100dvh - 180px);
    padding: 120px 0;
  }
  .btn {
    margin-top: 32px;
  }
</style>
