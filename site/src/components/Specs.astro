---
import { copy } from "../copy";
---

<section class="specs wrap" aria-labelledby="specs-title">
  <h2 class="section-title" id="specs-title">{copy.specs.title}</h2>
  <dl>
    {
      copy.specs.rows.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .specs {
    padding-top: 140px;
    padding-bottom: 160px;
  }
  dl {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 64px;
    max-width: 960px;
  }
  dl div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--quiet);
    font-size: 15px;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 900px) {
    dl {
      grid-template-columns: 1fr;
    }
    dl div {
      grid-template-columns: 120px 1fr;
    }
  }
</style>
