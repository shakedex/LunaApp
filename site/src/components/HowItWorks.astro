---
import { copy } from "../copy";

const shots = ["idle", "running", "done"] as const;
const strips = ["P1066462", "P1066468", "P1066471"];
---

<section class="how" id="how" aria-labelledby="how-title">
  <h2 class="sr-only" id="how-title">{copy.how.title}</h2>

  <!-- Without motion: the three stages, one after another. -->
  <ol class="static wrap">
    {
      copy.how.stages.map((stage, i) => (
        <li>
          <div class="caption">
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
          </div>
          <img
            class="shot"
            src={`/img/app-${shots[i]}@2x.webp`}
            alt={stage.alt}
            width="1760"
            height="1280"
            loading="lazy"
          />
        </li>
      ))
    }
  </ol>

  <!-- With motion: one pinned window that scroll walks through (scripts/scroll.ts). -->
  <div class="pinned" aria-hidden="true">
    <div class="stage wrap">
      <div class="captions">
        {
          copy.how.stages.map((stage, i) => (
            <div class="how-stage" data-stage={i}>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
            </div>
          ))
        }
      </div>
      <div class="window" id="app-window">
        {shots.map((s) => <img class={`layer layer-${s}`} src={`/img/app-${s}-nomoon@2x.webp`} alt="" width="1760" height="1280" />)}
        <div id="window-moon-slot"></div>
        <div class="cards">
          {[0, 1, 2].map(() => <span class="card" />)}
        </div>
        <div class="strips">
          {
            strips.map((clip) => (
              <div class="strip">
                {[0, 1, 2].map((i) => <img src={`/img/strips/${clip}_${i}.webp`} alt="" width="640" height="360" />)}
              </div>
            ))
          }
        </div>
      </div>
      <img class="page" src="/img/report-light-p1.webp" alt="" width="2339" height="1654" />
    </div>
  </div>
</section>

<style>
  .how {
    position: relative;
    padding: 120px 0;
  }
  .static {
    list-style: none;
    margin: 0 auto;
    display: grid;
    gap: 120px;
  }
  .static li {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 64px;
    align-items: center;
  }
  h3 {
    font-size: 30px;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .caption p,
  .how-stage p {
    color: var(--muted);
    margin: 0;
    max-width: 34ch;
  }
  .shot,
  .window {
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    box-shadow:
      0 40px 120px -30px rgba(121, 202, 234, 0.16),
      0 30px 80px -20px rgba(2, 4, 8, 0.9);
  }
  .pinned {
    display: none;
  }

  /* Motion layout, switched on by html.motion. */
  :global(html.motion) .static {
    display: none;
  }
  :global(html.motion) .pinned {
    display: block;
  }
  .stage {
    position: relative;
    height: 100dvh;
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 64px;
    align-items: center;
  }
  .captions {
    position: relative;
    height: 200px;
  }
  .how-stage {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .how-stage[data-stage="0"] {
    opacity: 1;
  }
  .window {
    position: relative;
    aspect-ratio: 1760 / 1280;
    overflow: hidden;
    background: var(--canvas);
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .layer-idle {
    opacity: 1;
  }
  #window-moon-slot {
    position: absolute;
  }
  .cards {
    position: absolute;
    left: 50%;
    top: -30%;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }
  .card {
    width: 42px;
    height: 56px;
    border-radius: 6px;
    background: linear-gradient(160deg, #2b3341, #181d25);
    border: 1px solid #3a4456;
  }
  .strips {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .strip {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    gap: 3px;
    width: 46%;
    opacity: 0;
    transform: translate(-50%, -50%);
  }
  .strip img {
    width: 33.3%;
    border-radius: 2px;
  }
  .page {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: 62%;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(-50%);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
  }
  @media (max-width: 900px) {
    .static li {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .static {
      gap: 72px;
    }
  }
</style>
