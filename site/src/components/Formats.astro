---
import { copy } from "../copy";
import sony from "simple-icons/icons/sony.svg?raw";
import blackmagicdesign from "simple-icons/icons/blackmagicdesign.svg?raw";
import nikon from "simple-icons/icons/nikon.svg?raw";
import apple from "simple-icons/icons/apple.svg?raw";
import arri from "../assets/logos/arri.svg?raw";
import canon from "../assets/logos/canon.svg?raw";

const logos: Record<string, string> = { sony, blackmagicdesign, nikon, apple, arri, canon };
const wide = new Set(["sony", "nikon", "arri", "canon"]);
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <h2 class="title" id="formats-title">{copy.formats.title}</h2>

    <ul class="grid">
      {
        copy.formats.rows.map((row) => (
          <li>
            <div class="maker">
              {row.logo === "red" ? (
                <img class="logo-img" src="/img/logos/red.png" alt={row.maker} width="218" height="54" />
              ) : row.logo ? (
                <>
                  <span class={`logo ${wide.has(row.logo) ? "wide" : ""} ${row.logo}`} set:html={logos[row.logo]} />
                  <span class="sr-only">{row.maker}</span>
                </>
              ) : (
                <span class="wordmark">{row.maker}</span>
              )}
            </div>
            {row.formats.length > 0 && <p class="list">{row.formats.join(", ")}</p>}
            <p class="ext data">{row.ext.join("  ")}</p>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 32px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-window);
    overflow: hidden;
  }
  .grid li {
    background: var(--canvas);
    padding: 22px 22px 20px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .maker {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }
  .logo :global(svg) {
    height: 26px;
    width: 26px;
    fill: currentColor;
    display: block;
  }
  /* Wordmark logos sit small in their square; give them room. */
  .logo.wide :global(svg) {
    height: 72px;
    width: 72px;
    margin: -22px -8px;
  }
  .logo-img {
    height: 17px;
    width: auto;
  }
  /* The ARRI and Canon marks come as wordmarks already. */
  .logo.arri :global(svg),
  .logo.canon :global(svg) {
    height: 18px;
    width: auto;
    margin: 0;
  }
  .wordmark {
    font-size: 16px;
    font-weight: 600;
  }
  .list {
    font-size: 15px;
    color: var(--text);
    line-height: 1.4;
  }
  .ext {
    font-size: 12px;
    color: var(--quiet);
    white-space: pre;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .grid li {
      padding: 16px 14px 14px;
      gap: 8px;
    }
    .list {
      font-size: 14px;
    }
    .ext {
      font-size: 11px;
      white-space: pre-wrap;
    }
  }
</style>
