---
import { copy } from "../copy";
import sony from "simple-icons/icons/sony.svg?raw";
import red from "simple-icons/icons/red.svg?raw";
import blackmagicdesign from "simple-icons/icons/blackmagicdesign.svg?raw";
import nikon from "simple-icons/icons/nikon.svg?raw";
import apple from "simple-icons/icons/apple.svg?raw";

const logos: Record<string, string> = { sony, red, blackmagicdesign, nikon, apple };
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <div class="head">
      <h2 class="title" id="formats-title">{copy.formats.title}</h2>
      <p class="note">{copy.formats.lede}</p>
    </div>

    <ul class="grid">
      {
        copy.formats.rows.map((row) => (
          <li>
            <div class="maker">
              {row.logo ? (
                <>
                  <span class={`logo ${row.logo === "sony" || row.logo === "nikon" ? "wide" : ""}`} set:html={logos[row.logo]} />
                  <span class="sr-only">{row.maker}</span>
                </>
              ) : (
                <span class="wordmark">{row.maker}</span>
              )}
            </div>
            <p class="list">{row.formats.join(", ")}</p>
            <p class="ext data">{row.ext.join("  ")}</p>
          </li>
        ))
      }
    </ul>

    <p class="sidecars">
      <span class="label">{copy.formats.sidecarsLabel}</span>
      <span>{copy.formats.sidecars}</span>
    </p>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .note {
    color: var(--muted);
    font-size: 15.5px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 32px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-window);
    overflow: hidden;
  }
  .grid li {
    background: var(--canvas);
    padding: 22px 22px 20px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .maker {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }
  .logo :global(svg) {
    height: 26px;
    width: 26px;
    fill: currentColor;
    display: block;
  }
  /* Wordmark logos sit small in their square; give them room. */
  .logo.wide :global(svg) {
    height: 72px;
    width: 72px;
    margin: -22px -8px;
  }
  .wordmark {
    font-size: 16px;
    font-weight: 600;
  }
  .list {
    font-size: 15px;
    color: var(--text);
    line-height: 1.4;
  }
  .ext {
    font-size: 12px;
    color: var(--quiet);
    white-space: pre;
  }
  .sidecars {
    margin-top: 20px;
    display: flex;
    gap: 16px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sidecars .label {
    color: var(--text);
    font-weight: 500;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .head {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
