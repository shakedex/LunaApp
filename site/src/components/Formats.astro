---
import { copy } from "../copy";
const rows = copy.formats.rows;
const half = Math.ceil(rows.length / 2);
const columns = [rows.slice(0, half), rows.slice(half)];
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <h2 class="title" id="formats-title">{copy.formats.title}</h2>
    <p class="lede">{copy.formats.lede}</p>

    <div class="matrix">
      {
        columns.map((col) => (
          <ul>
            {col.map((row) => (
              <li>
                <span class="maker">{row.maker}</span>
                <span class="list">
                  {row.formats.map((f) => (
                    <span class="format">{f}</span>
                  ))}
                </span>
                <span class="ext data">{row.ext.join("  ")}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <p class="sidecars">
      <span class="label">{copy.formats.sidecarsLabel}</span>
      <span>{copy.formats.sidecars}</span>
    </p>
  </div>
</section>

<style>
  .matrix {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 72px;
    margin-top: 48px;
    border-top: 1px solid var(--line-strong);
  }
  .matrix li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 6px 24px;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--line);
  }
  .maker {
    font-size: 17px;
    font-weight: 500;
    grid-row: span 2;
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 17px;
  }
  .ext {
    font-size: 12.5px;
    color: var(--quiet);
    white-space: pre;
  }
  .sidecars {
    margin-top: 32px;
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 24px;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 760px;
  }
  .sidecars .label {
    color: var(--text);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .matrix {
      grid-template-columns: 1fr;
    }
    .matrix li,
    .sidecars {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .maker {
      grid-row: auto;
    }
  }
</style>
