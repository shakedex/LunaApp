---
import { copy } from "../copy";
---

<footer class="footer">
  <div class="wrap row">
    <a class="home" href="/" aria-label="Luna home">
      <img src="/img/luna-icon.png" alt="" width="24" height="24" />
      <span>Luna</span>
    </a>
    <ul class="links">
      {copy.footer.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div class="wrap">
    <p class="legal">{copy.footer.legal}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 40px 0 48px;
    background: var(--chrome);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
  }
  .home img {
    border-radius: 6px;
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 14.5px;
    color: var(--muted);
    margin-left: auto;
  }
  .links a:hover {
    color: var(--text);
  }
  .legal {
    margin-top: 28px;
    font-size: 13px;
    color: var(--quiet);
    max-width: 72ch;
    line-height: 1.55;
  }
</style>
