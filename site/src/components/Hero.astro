---
import { copy, RELEASES_LATEST } from "../copy";
---

<section class="hero wrap">
  <div class="text">
    <h1>{copy.hero.title}</h1>
    <p class="lede">{copy.hero.lede}</p>
    <div class="cta">
      <a class="btn" href={RELEASES_LATEST} data-download>
        <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" width="18" height="18">
          <path d="M224 144v64a8 8 0 0 1-8 8H40a8 8 0 0 1-8-8v-64a8 8 0 0 1 16 0v56h160v-56a8 8 0 0 1 16 0Zm-101.66 5.66a8 8 0 0 0 11.32 0l40-40a8 8 0 0 0-11.32-11.32L136 124.69V32a8 8 0 0 0-16 0v92.69L93.66 98.34a8 8 0 0 0-11.32 11.32Z"></path>
        </svg>
        <span data-download-label>Download for Windows</span>
      </a>
      <span class="alt">{copy.hero.alsoOn} <a href={RELEASES_LATEST} data-download-other>macOS</a></span>
    </div>
  </div>
  <figure class="moon">
    <div class="slot" id="hero-moon-slot">
      <img id="moon-still" src="/img/moon-still.webp" alt={copy.hero.moonLabel} width="1200" height="1200" fetchpriority="high" decoding="async" />
    </div>
    <figcaption class="readout" aria-live="polite">
      <b id="clip-count">Report ready</b>
      <span id="clip-sub">PDF, HTML and CSV</span>
    </figcaption>
  </figure>
</section>

<script>
  import { detectPlatform, downloadLabels } from "../lib/platform";
  const labels = downloadLabels(detectPlatform(navigator.userAgent));
  document.querySelectorAll("[data-download-label]").forEach((el) => (el.textContent = labels.primary));
  document.querySelectorAll("[data-download-other]").forEach((el) => (el.textContent = labels.secondary));
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 48px;
    min-height: calc(100dvh - 72px);
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(44px, 4.9vw, 70px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 0 0 24px;
    max-width: 14ch;
  }
  .lede {
    font-size: 20px;
    font-weight: 300;
    color: var(--muted);
    max-width: 34ch;
    margin: 0 0 36px;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .alt {
    color: var(--muted);
    font-size: 15px;
  }
  .alt a {
    color: var(--text);
    text-underline-offset: 3px;
  }
  .moon {
    margin: 0;
    justify-self: end;
    width: min(100%, 560px);
  }
  .slot {
    aspect-ratio: 1;
    width: 100%;
  }
  .slot img {
    width: 100%;
    height: 100%;
    transition: opacity 0.6s;
  }
  .readout {
    text-align: center;
    margin-top: 8px;
  }
  .readout b {
    display: block;
    font-size: 22px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .readout span {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 32px var(--gutter) 64px;
    }
    .moon {
      justify-self: center;
      width: min(100%, 400px);
    }
  }
</style>
