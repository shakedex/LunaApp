---
import { copy, LATEST_URL } from "../copy";
---

<header class="nav">
  <nav class="pill" aria-label="Site">
    <a class="home" href="/" aria-label="Luna home">
      <img src="/img/luna-icon.png" alt="" width="26" height="26" />
      <span>Luna</span>
    </a>
    <a href="#report">{copy.nav.report}</a>
    <a href="#formats">{copy.nav.formats}</a>
    <a class="btn btn-primary small" href={LATEST_URL}>{copy.nav.download}</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding-top: 16px;
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 30px;
    height: 52px;
    padding: 0 8px 0 16px;
    border-radius: 999px;
    background: rgb(12 15 20 / 0.72);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgb(255 255 255 / 0.09);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.8);
    font-size: 14.5px;
    color: var(--muted);
  }
  .pill > a {
    transition: color 0.15s var(--ease-out);
  }
  .pill > a:hover {
    color: var(--text);
  }
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
    margin-right: 6px;
  }
  .home img {
    border-radius: 7px;
  }
  .btn.small {
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--on-accent);
  }
  .btn.small:hover {
    color: var(--on-accent);
  }
  @media (max-width: 600px) {
    .pill {
      gap: 18px;
    }
  }
</style>
