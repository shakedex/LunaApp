{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luna-site",
  "compatibility_date": "2026-10-24",
  "routes": [{ "pattern": "luna.shaked.co", "custom_domain": true }],
  // One public host, so search engines see no duplicate of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
