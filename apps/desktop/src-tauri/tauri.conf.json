{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Luna",
  "mainBinaryName": "Luna",
  "version": "0.2.0",
  "identifier": "com.lunaweb.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../web build:desktop",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Luna",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Shaked Lipszyc",
    "copyright": "Copyright 2026 Shaked Lipszyc",
    "shortDescription": "Camera reports, generated entirely client-side.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
