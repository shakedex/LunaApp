{
  "name": "luna-web-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --filter ./apps/web dev",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run -r test",
    "test:tools": "bun test tools",
    "build": "vp run -r --cache build",
    "release": "bun tools/release.ts",
    "release:desktop": "bun tools/release-desktop.ts",
    "prepare": "vp config --no-hooks"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "exiftool-vendored": "^37.0.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  }
}
